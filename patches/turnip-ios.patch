diff --git a/src/freedreno/vulkan/tu_knl_drm_msm.cc b/src/freedreno/vulkan/tu_knl_drm_msm.cc
index 08831e7..692c18b 100644
--- a/src/freedreno/vulkan/tu_knl_drm_msm.cc
+++ b/src/freedreno/vulkan/tu_knl_drm_msm.cc
@@ -739,10 +739,18 @@ msm_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
    if (!offset)
       return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
 
+#ifdef __APPLE__
+   /* Chlorophyll: a BO map is an IOConnectMapMemory64 mapping made by the libdrm stand-in (gpu/freedreno-sweet), which cannot be
+    * placed at a fixed address */
+   if (placed_addr != NULL)
+      return vk_error(dev, VK_ERROR_MEMORY_MAP_FAILED);
+   void *map = sweet_drm_mmap(dev->fd, bo->size, offset);
+#else
    /* TODO: Should we use the wrapper os_mmap() like Freedreno does? */
    void *map = mmap(placed_addr, bo->size, PROT_READ | PROT_WRITE,
                     MAP_SHARED | (placed_addr != NULL ? MAP_FIXED : 0),
                     dev->fd, offset);
+#endif
    if (map == MAP_FAILED)
       return vk_error(dev, VK_ERROR_MEMORY_MAP_FAILED);
 
@@ -996,7 +1004,13 @@ tu_knl_drm_msm_load(struct tu_instance *instance,
 
    /* Version 1.6 added SYNCOBJ support. */
    const int min_version_major = 1;
+#ifdef __APPLE__
+   /* Chlorophyll: the libdrm stand-in reports 1.4 (what Gallium freedreno must see) and emulates syncobjs on top of the
+    * kernel's fences itself */
+   const int min_version_minor = 4;
+#else
    const int min_version_minor = 6;
+#endif
 
    if (version->version_major != min_version_major ||
        version->version_minor < min_version_minor) {
@@ -1050,6 +1064,11 @@ tu_knl_drm_msm_load(struct tu_instance *instance,
 
    device->has_set_iova = !tu_drm_get_va_prop(device, &device->va_start,
                                               &device->va_size);
+#ifdef __APPLE__
+   /* Chlorophyll: one GPU address space for every process (PP_PGTABLE 0), and Gallium's BOs get kernel-assigned addresses in
+    * it, so Turnip takes the kernel's addresses too (GET_IOVA) instead of picking its own */
+   device->has_set_iova = false;
+#endif
    device->has_raytracing = tu_drm_get_raytracing(device);
 
    device->has_preemption = tu_drm_has_preemption(device);
