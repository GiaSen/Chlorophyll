diff --git a/src/util/cache_ops_aarch64.c b/src/util/cache_ops_aarch64.c
index d56ab8a..ff7706a 100644
--- a/src/util/cache_ops_aarch64.c
+++ b/src/util/cache_ops_aarch64.c
@@ -26,12 +26,29 @@
 #include "util/macros.h"
 #include "util/u_atomic.h"
 
+#ifdef __APPLE__
+#include <sys/sysctl.h>
+#endif
+
 static uint32_t
 get_ctr_el0(void)
 {
+#ifdef __APPLE__
+   /* Chlorophyll: Bergamota's XNU traps EL0 reads of CTR_EL0 (SIGILL). Build the fields read here (CWG [27:24],
+    * DminLine [19:16], IminLine [3:0], all log2 of words) from the line size the kernel reports. */
+   uint64_t line = 0;
+   size_t len = sizeof(line);
+   if (sysctlbyname("hw.cachelinesize", &line, &len, NULL, 0) != 0 || line < 16)
+      line = 64;
+   uint32_t lg = 0;
+   while ((4u << lg) < line)
+      lg++;
+   return lg << 24 | lg << 16 | lg;
+#else
    uint32_t ctr_el0;
    __asm("mrs\t%x0, ctr_el0" : "=r"(ctr_el0));
    return ctr_el0;
+#endif
 }
 
 static uint32_t
