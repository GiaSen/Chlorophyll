    if (reserve) {
+#ifdef __APPLE__
+      sweet_drm_munmap(bo->map, bo->size);   /* Chlorophyll: release the IOKit mapping first */
+#endif
       void *map = mmap(bo->map, bo->size, PROT_NONE,
