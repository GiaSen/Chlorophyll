diff -ruN a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
--- a/src/gallium/drivers/freedreno/freedreno_screen.c	2026-10-26 10:46:48
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c	2026-10-26 10:46:48
@@ -1162,3 +1162,21 @@
    simple_mtx_unlock(&screen->aux_ctx_lock);
 }
 
+/* Chlorophyll: the screen's GPU buffer totals and the trim of its caches, for a user of the screen that sees only
+ * struct pipe_screen (libbgair's rwa_device_memory / rwa_device_trim) */
+void fd_screen_memory_stats(struct pipe_screen *pscreen, unsigned *live_bos, uint64_t *live_bytes, uint64_t *mapped_bytes,
+                            unsigned *cached_bos, uint64_t *cached_bytes);
+void fd_screen_trim(struct pipe_screen *pscreen);
+
+void
+fd_screen_memory_stats(struct pipe_screen *pscreen, unsigned *live_bos, uint64_t *live_bytes, uint64_t *mapped_bytes,
+                       unsigned *cached_bos, uint64_t *cached_bytes)
+{
+   fd_device_memory_stats(fd_screen(pscreen)->dev, live_bos, live_bytes, mapped_bytes, cached_bos, cached_bytes);
+}
+
+void
+fd_screen_trim(struct pipe_screen *pscreen)
+{
+   fd_device_trim_caches(fd_screen(pscreen)->dev);
+}
