diff -ruN a/src/freedreno/drm/freedreno_bo_cache.c b/src/freedreno/drm/freedreno_bo_cache.c
--- a/src/freedreno/drm/freedreno_bo_cache.c	2026-10-26 10:46:48
+++ b/src/freedreno/drm/freedreno_bo_cache.c	2026-10-26 10:46:48
@@ -307,3 +307,42 @@
    return -1;
 }
 
+/* Chlorophyll: what a device holds in buffers (alive, mapped into the process, kept in the two caches for reuse), and
+ * a way to give back every cached one. iOS charges a process for its mapped GPU memory and kills an idle
+ * iconservicesagent above 17 MB, so an idle process empties the caches (fd_screen_trim). */
+void
+fd_device_memory_stats(struct fd_device *dev, unsigned *live_bos, uint64_t *live_bytes, uint64_t *mapped_bytes,
+                       unsigned *cached_bos, uint64_t *cached_bytes)
+{
+   *live_bos = *cached_bos = 0;
+   *live_bytes = *mapped_bytes = *cached_bytes = 0;
+   simple_mtx_lock(&table_lock);
+   hash_table_foreach (dev->handle_table, e) {
+      const struct fd_bo *bo = e->data;
+      if (p_atomic_read(&bo->refcnt) == 0) {
+         (*cached_bos)++;
+         *cached_bytes += bo->size;
+      } else {
+         (*live_bos)++;
+         *live_bytes += bo->size;
+      }
+      if (bo->map)
+         *mapped_bytes += bo->size;
+      if (getenv("FD_MEMSTATS_LIST"))
+         fprintf(stderr, "  bo handle %u: %u bytes, refcnt %d, alloc_flags 0x%x, %s, iova 0x%llx\n", bo->handle, bo->size,
+                 bo->refcnt, bo->alloc_flags, bo->map ? "mapped" : "not mapped", (unsigned long long)bo->iova);
+   }
+   simple_mtx_unlock(&table_lock);
+}
+
+void
+fd_device_trim_caches(struct fd_device *dev)
+{
+   /* any time far past every buffer's free_time frees them all; each cache's own clock is put back so its next timed
+    * cleanup is not skipped as "already done" */
+   time_t t0 = dev->bo_cache.time, t1 = dev->ring_cache.time;
+   fd_bo_cache_cleanup(&dev->bo_cache, (time_t)INT32_MAX);
+   fd_bo_cache_cleanup(&dev->ring_cache, (time_t)INT32_MAX);
+   dev->bo_cache.time = t0;
+   dev->ring_cache.time = t1;
+}
